// Règles de sécurité Firebase STORAGE (différentes des règles Firestore).
//
// OÙ LES COLLER :
// Console Firebase → votre projet → Storage → onglet "Rules"
// (si "Storage" n'apparaît pas encore dans le menu, cliquez dessus une première fois
// pour l'activer — "Commencer" / "Get started" — avant de pouvoir coller ces règles)
//
// CE QUE ÇA FAIT :
//  - tout le monde peut VOIR les photos de produits (nécessaire pour les afficher
//    dans le marché, même à quelqu'un qui n'est pas connecté)
//  - seul un compte connecté peut ENVOYER une photo (empêche l'upload anonyme)

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
